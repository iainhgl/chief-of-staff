# CoS Platform Configuration
#
# Copy this file to config.yaml and fill in the required values.
# config.yaml is git-ignored and never committed.
#
# All keys listed here correspond to the CosConfig Pydantic model in src/cos/config.py.
# The platform will validate config at startup and print human-readable errors for any
# missing or invalid values.

# ─────────────────────────────────────────────
# LLM Provider
# Controls which language model is used for synthesis and reasoning.
# provider: the LLM provider name (currently only "anthropic" is implemented)
# model: the specific model to use (e.g. "claude-sonnet-4-6", "claude-opus-4-7")
# api_key: your Anthropic API key (required)
# ca_bundle_path / proxy_url / trust_env: optional network overrides for the LLM provider.
#   If omitted, the runtime will fall back to the embedding transport settings below.
# ─────────────────────────────────────────────
llm:
  provider: anthropic
  model: claude-sonnet-4-6
  api_key: YOUR_API_KEY_HERE
  ca_bundle_path: null
  proxy_url: null
  trust_env: null

# ─────────────────────────────────────────────
# Embedding Provider
# Controls which embedding model is used when indexing documents.
# provider: the embedding provider name (e.g. "anthropic" for Voyage models)
# model: the specific embedding model (e.g. "voyage-3")
# api_key: only set this if your embedding provider uses a DIFFERENT API key than llm.api_key.
#   Leave as null (or omit) when both providers share the same key.
# ca_bundle_path: optional PEM file for a corporate TLS root/intercept certificate (for example Zscaler).
#   When running in Docker, place the PEM in ./local/certs/ so it is visible inside the
#   container at /certs/<filename>. Example: ./local/certs/zscaler-root.pem -> /certs/zscaler-root.pem
# proxy_url: optional explicit HTTP/HTTPS proxy for Voyage requests.
# trust_env: set to true if the host/container should honor HTTPS_PROXY / HTTP_PROXY / NO_PROXY.
# ─────────────────────────────────────────────
embedding:
  provider: anthropic
  model: voyage-3
  api_key: null
  # Example when using a corporate TLS root mounted from ./local/certs:
  # ca_bundle_path: /certs/zscaler-root.pem
  ca_bundle_path: null
  proxy_url: null
  trust_env: false

# ─────────────────────────────────────────────
# Role Pack
# Points to the YAML file that defines the active role identity.
# The role pack controls: role_name, goals, tone, knowledge_taxonomy,
# stakeholder_map, retrieval_priorities, active_workflows, output_channels.
# path: path relative to the cos/ directory to the role pack YAML file.
# Example: role_packs/chro.yaml is the CHRO role pack provided with the platform.
# ─────────────────────────────────────────────
role_pack:
  path: role_packs/chro.yaml

# ─────────────────────────────────────────────
# Output Channels
# Lists the output channels the platform is permitted to deliver responses through.
# "local" means MCP tool responses (the only channel available in Epic 1).
# Additional channels (telegram, email) are added in later epics.
# ─────────────────────────────────────────────
channels:
  - local

# ─────────────────────────────────────────────
# Connectors
# Lists the external data connectors to activate (e.g. gmail, google_calendar, telegram).
# Leave empty for local-only deployments.
# To enable Gmail: add "gmail" and configure the gmail: block below.
# To enable Google Calendar: add "google_calendar" and configure the google_calendar: block below.
# To enable Telegram polling: add "telegram" and configure the telegram: block below.
# ─────────────────────────────────────────────
connectors: []

# ─────────────────────────────────────────────
# Database
# Connection settings for the Postgres instance managed by Docker Compose.
# host: use "postgres" (the Docker Compose service name) when running inside Docker.
#   Use "localhost" only when connecting from outside the container network.
# port: Postgres default (5432)
# user/dbname: match the values in docker-compose.yml (default: postgres / cos)
# password: MUST match the POSTGRES_PASSWORD environment variable in docker-compose.yml.
#   The default in docker-compose.yml is "postgres". If you change it here, you must
#   also update docker-compose.yml — the two are not linked automatically.
#   SECURITY: Change this from the default "postgres" before deploying to any shared or
#   production environment — do not copy this value as-is outside a local development setup.
# ─────────────────────────────────────────────
database:
  host: postgres
  port: 5432
  user: postgres
  password: postgres
  dbname: cos

# ─────────────────────────────────────────────
# Tika
# Connection settings for the Apache Tika document extraction service.
# url: the Tika server base URL. Use "http://tika:9998" (the Docker Compose service name)
#   when running inside Docker. The platform uses Tika to extract text from PDFs, Word
#   documents, and other file formats. This service is started automatically by Docker Compose.
# ─────────────────────────────────────────────
tika:
  url: http://tika:9998

# ─────────────────────────────────────────────
# Storage
# Directories where the ingestion pipeline writes files inside the container.
# These paths map to the host via the Docker Compose volume mount: ./data:/data
# originals_dir: byte-for-byte copy of every source file; never modified after write
# markdown_dir: extracted plain-text working copy of each document; used for chunking
# Both directories are created automatically on first ingest if they do not exist.
# ─────────────────────────────────────────────
storage:
  originals_dir: /data/originals
  markdown_dir: /data/markdown

# ─────────────────────────────────────────────
# Chunking
# Controls how extracted document text is split before embedding.
# chunk_size: target token count per chunk (default: 1024)
# chunk_overlap: token overlap between adjacent chunks for context continuity (default: 100)
# Changing chunk_size requires re-embedding all existing documents.
# ─────────────────────────────────────────────
chunking:
  chunk_size: 1024
  chunk_overlap: 100

# ─────────────────────────────────────────────
# Google OAuth (required for Epic 6 connected-source auth only)
# Needed to run `cos auth gmail` and `cos auth calendar`.
# Leave this block absent or commented out for Epic 1–5 local-only deployments.
#
# How to obtain these values:
#   1. Go to Google Cloud Console → APIs & Services → Credentials
#   2. Create an OAuth 2.0 Client ID (Application type: Desktop app)
#   3. Copy the client_id and client_secret values here
#
# The client_secret is masked in all log output and repr() calls.
# Token files (tokens/gmail.json, tokens/google_calendar.json) are gitignored.
# ─────────────────────────────────────────────
# google_oauth:
#   client_id: YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
#   client_secret: YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# ─────────────────────────────────────────────
# Gmail Connector (optional — requires google_oauth block above and "gmail" in connectors)
# Controls how the Gmail connector polls for new messages when you run `cos sync gmail`.
# Omit this block entirely to use all defaults (inbox, last 25 messages, no spam/trash).
#
# query: Gmail search query string (same syntax as the Gmail search box).
#   Example: "is:unread newer_than:1d" polls only recent unread messages.
#   Leave null to fetch the most recent messages with no filter.
# label_ids: restrict polling to specific labels (e.g. ["INBOX", "IMPORTANT"]).
#   Leave empty to search across all labels.
# max_results: maximum messages per poll cycle (1–500, default 25).
# include_spam_trash: set to true to include Spam and Trash folders (default false).
# staging_dir: shared volume path where the connector stages files before enqueueing.
#   Must be on the shared Docker volume so the background worker can read it.
#   Default: /data/connector-staging/gmail
# ─────────────────────────────────────────────
# gmail:
#   query: null
#   label_ids: []
#   max_results: 25
#   include_spam_trash: false
#   staging_dir: /data/connector-staging/gmail

# ─────────────────────────────────────────────
# Google Calendar Connector (optional — requires google_oauth block above and "google_calendar" in connectors)
# Controls how the Calendar connector fetches upcoming events when you run `cos sync calendar`.
# Omit this block entirely to use all defaults.
#
# calendar_ids: list of calendar IDs to sync (use "primary" for the authenticated user's primary calendar).
# lookback_hours: how many hours in the past to include (default 12, covers events that started recently).
# lookahead_days: how many days ahead to fetch (default 14).
# max_results: maximum events per calendar per sync cycle (1–2500, default 100).
# staging_dir: shared volume path where the connector stages event files before enqueueing.
#   Must be on the shared Docker volume so the background worker can read it.
#   Default: /data/connector-staging/google-calendar
# ─────────────────────────────────────────────
# google_calendar:
#   calendar_ids:
#     - primary
#   lookback_hours: 12
#   lookahead_days: 14
#   max_results: 100
#   staging_dir: /data/connector-staging/google-calendar

# ─────────────────────────────────────────────
# Telegram Connector (optional — requires "telegram" in connectors list above)
# Enables the Telegram bot for outbound delivery and inbound polling.
#
# How to create a bot:
#   1. Open Telegram and search for @BotFather.
#   2. Send /newbot and follow the prompts to get your bot_token.
#   3. Start a conversation with your bot and send a message.
#   4. Retrieve the chat_id with:
#      curl "https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates"
#
# bot_token: the HTTP API token from BotFather (treated as a secret — never logged).
# chat_id: the numeric Telegram chat ID the bot should deliver messages to and accept messages from.
# api_base_url: override the Telegram API base URL (default: https://api.telegram.org).
# poll_timeout: long-poll timeout in seconds for getUpdates (1–120, default 30).
# backoff_initial: initial retry delay in seconds after a transient error (default 1.0).
# backoff_max: maximum retry delay in seconds (default 60.0).
# staging_dir: shared volume path where Telegram note files are staged before enqueueing.
#   Must be on the shared Docker volume so the background worker can read it.
#   Default: /data/connector-staging/telegram
#
# To activate: uncomment the block below, fill in your values, and add "telegram" to connectors.
# ─────────────────────────────────────────────
# telegram:
#   bot_token: YOUR_TELEGRAM_BOT_TOKEN
#   chat_id: "123456789"
#   api_base_url: https://api.telegram.org
#   poll_timeout: 30
#   backoff_initial: 1.0
#   backoff_max: 60.0
#   staging_dir: /data/connector-staging/telegram

# ─────────────────────────────────────────────
# MCP Note Ingest (optional — controls ingest_document tool behaviour)
# Omit this block entirely to use all defaults.
#
# staging_dir: shared volume path where MCP notes are staged before ingest.
#   Must be on the shared Docker volume for compatibility with future message-channel paths.
#   Default: /data/connector-staging/mcp
# near_duplicate_threshold: cosine similarity score at or above which a warning is
#   returned alongside a successful ingest (0.0–1.0, default 0.95).
#   Only used when semantic similarity checking can run (embedding key required).
# ─────────────────────────────────────────────
# mcp_note:
#   staging_dir: /data/connector-staging/mcp
#   near_duplicate_threshold: 0.95

# ─────────────────────────────────────────────
# Retrieval (optional — controls relevance filtering and citation pruning)
# Omit this block entirely to use all defaults (no floor, 2 chunks per source).
#
# min_score: RRF relevance floor applied before role-priority weighting (0.0–1.0, default 0.0).
#   Chunks scoring below this raw RRF threshold are excluded from synthesis and citations.
#   RRF scores top out at ~0.033 for a rank-1 result in both keyword and semantic search,
#   so values in the range 0.001–0.02 are practical; 0.0 (the default) preserves existing behaviour.
#   Role-priority weights are applied after this floor — they cannot resurrect filtered chunks.
# max_chunks_per_source: maximum chunks from the same source document included per query
#   (minimum 1, default 2). Reduces citation spam when a single document dominates search results.
# ─────────────────────────────────────────────
# retrieval:
#   min_score: 0.0
#   max_chunks_per_source: 2
