# CoS Instance Environment
# Generated by scripts/init-instance.sh for instance: {{INSTANCE_NAME}}
#
# COMPOSE_PROJECT_NAME ensures Docker Compose resources (volumes, networks, container names)
# are namespaced per instance and do not collide across side-by-side instances.
#
# Ports are computed from the instance name and should be unique per instance.
# If two instances collide, edit POSTGRES_PORT and TIKA_PORT here.

COMPOSE_PROJECT_NAME={{COMPOSE_PROJECT_NAME}}
COS_IMAGE_TAG=local

# Postgres host port — must be unique per running instance
POSTGRES_PORT={{POSTGRES_PORT}}

# Tika host port — must be unique per running instance
TIKA_PORT={{TIKA_PORT}}

# Database settings — must match database: block in config.yaml
POSTGRES_DB=cos
POSTGRES_PASSWORD=postgres
