# CoS Instance Compose — generated by scripts/init-instance.sh
# Instance: {{INSTANCE_NAME}}
#
# This file uses image references only. Build the image from the repo before starting:
#   docker build -t cos-platform:${COS_IMAGE_TAG:-local} /path/to/cos-repo
#
# Start from this folder:
#   docker compose up -d
#
# All bind mounts are instance-local (./data, ./tokens, etc.).
# All named volumes are namespaced by COMPOSE_PROJECT_NAME automatically.

services:
  postgres:
    image: pgvector/pgvector:pg16
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-15432}:5432"
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
      POSTGRES_DB: ${POSTGRES_DB:-cos}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 12

  tika:
    image: apache/tika
    ports:
      - "127.0.0.1:${TIKA_PORT:-19998}:9998"
    healthcheck:
      test: ["CMD-SHELL", "(echo > /dev/tcp/localhost/9998) &>/dev/null"]
      interval: 5s
      timeout: 5s
      retries: 12

  cos:
    image: cos-platform:${COS_IMAGE_TAG:-local}
    stdin_open: true
    depends_on:
      postgres:
        condition: service_healthy
      tika:
        condition: service_healthy
    volumes:
      - ./data:/data
      - ./config.yaml:/app/config.yaml:ro
      - ./role_packs:/app/role_packs:ro
      - ./local/certs:/certs:ro
      - ./tokens:/app/tokens
    healthcheck:
      test: ["CMD-SHELL", "/app/.venv/bin/python -c 'import cos' 2>/dev/null && echo ok"]
      interval: 10s
      timeout: 5s
      retries: 6
    # No host ports — MCP uses stdio transport via docker compose exec

  worker:
    image: cos-platform:${COS_IMAGE_TAG:-local}
    command: ["uv", "run", "cos-worker"]
    depends_on:
      postgres:
        condition: service_healthy
      tika:
        condition: service_healthy
    volumes:
      - ./data:/data
      - ./config.yaml:/app/config.yaml:ro
      - ./role_packs:/app/role_packs:ro
      - ./local/certs:/certs:ro
      - ./tokens:/app/tokens
    restart: on-failure

  telegram-bot:
    image: cos-platform:${COS_IMAGE_TAG:-local}
    command: ["uv", "run", "cos-telegram-bot"]
    depends_on:
      postgres:
        condition: service_healthy
      tika:
        condition: service_healthy
    volumes:
      - ./data:/data
      - ./config.yaml:/app/config.yaml:ro
      - ./role_packs:/app/role_packs:ro
      - ./local/certs:/certs:ro
      - ./tokens:/app/tokens
    restart: on-failure
    # Only useful when "telegram" is listed in connectors in config.yaml.
    # Exits cleanly on startup when Telegram is not configured.

volumes:
  postgres_data:
