# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Operator config (contains secrets) — example template is intentionally tracked
config.yaml
config.host.yaml
!config.yaml.example

# OAuth tokens
tokens/

# Optional pyenv pin
# .python-version

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Codex agent skills (tooling infrastructure, not project code)
.agents/

# Runtime document storage (created by cos ingest)
data/

# Manual large-document evaluation corpus downloads
tests/fixtures/real_world_eval/originals/*
!tests/fixtures/real_world_eval/originals/.gitkeep
tests/fixtures/real_world_eval/snapshot-manifest.tsv

# Local certificate mounts for corporate TLS/proxy environments
local/certs/*
!local/certs/.gitkeep

# macOS metadata
.DS_Store
